<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RevitNumbering.Revit</RootNamespace>
    <AssemblyName>RevitNumbering.Revit</AssemblyName>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <OutputPath>..\artifacts\$(RevitVersion)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2022.1.1" Condition="'$(RevitVersion)' == '2022'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2022.1.1" Condition="'$(RevitVersion)' == '2022'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.0.0" Condition="'$(RevitVersion)' == '2024'" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.0.0" Condition="'$(RevitVersion)' == '2024'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitNumbering.Core\RevitNumbering.Core.csproj" />
  </ItemGroup>

</Project>
